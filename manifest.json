{
  "manifest_version": 3,
  "name": "Threaded",
  "version": "1.0.0",
  "description": "Save anything you want from any store into a shareable wishlist, sized and noted, so gift-givers know exactly what to get.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"]
}
